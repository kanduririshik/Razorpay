# ============================================================
# RecoverAI — Environment Configuration Template
# ============================================================
# Copy this file to .env.local (NEVER commit .env.local to Git)
# Enter your actual values in Vercel → Project → Environment Variables

# ============================================================
# RAZORPAY TEST MODE CREDENTIALS
# Obtain from: https://dashboard.razorpay.com → API Keys → Test Mode
# ============================================================
# Server-side only — NEVER expose in frontend/client code
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET

# For webhook signature verification
# Set this in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ============================================================
# APPLICATION BASE URL
# Required for Razorpay callback after payment
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
